{
  "rules": {
    ".read": false,
    ".write": false,
    "atc_notes": {
      ".read": true,
      "$not_id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['author', 'text', 'created_at'])",
        "author": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100 && !newData.val().matches(/^\\s*$/)"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000 && !newData.val().matches(/^\\s*$/)"
        },
        "created_at": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "awos_rvr": {
      ".read": true,
      "$rvr_id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['runway', 'position', 'value', 'unit', 'entered_at', 'source'])",
        "runway": {
          ".validate": "newData.isString() && (newData.val() === '06R' || newData.val() === '24R')"
        },
        "position": {
          ".validate": "newData.isString() && (newData.val() === 'TDZ' || newData.val() === 'MID' || newData.val() === 'STOP-END')"
        },
        "value": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
        },
        "unit": {
          ".validate": "newData.val() === 'm'"
        },
        "entered_at": {
          ".validate": "newData.val() === now"
        },
        "source": {
          ".validate": "newData.val() === 'MANUAL AWOS'"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
